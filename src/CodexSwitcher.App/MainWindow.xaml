<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexSwitcher.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:CodexSwitcher.App.Views"
    xmlns:tb="using:H.NotifyIcon"
    Title="Codex Switchboard">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <views:ShellView x:Name="Root" />
        <tb:TaskbarIcon x:Name="TrayIcon"
                        Width="0" Height="0" Opacity="0" IsHitTestVisible="False"
                        ToolTipText="Codex Switchboard"
                        IconSource="/Assets/icon.ico"
                        MenuActivation="RightClick"
                          PopupActivation="LeftClick"
                        NoLeftClickDelay="True" />
    </Grid>
</Window>
