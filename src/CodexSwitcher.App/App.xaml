<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CodexSwitcher.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Brand.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The default ContentDialog cap is too narrow for the fixed-footer provider editor. -->
            <x:Double x:Key="ContentDialogMaxWidth">940</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
