<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CodexSwitcher.App.Views.TrayQuickControlPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:CodexSwitcher.App.Support">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
        <Style x:Key="TrayPopupButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Border Width="380" MaxHeight="620" Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <StackPanel Spacing="2">
                <TextBlock Text="Codex Control Center" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind Loc.TrayActiveTarget}" Opacity="0.72" FontSize="12" />
                <TextBlock Text="{Binding Routing.ActiveTargetSummary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                <Button Grid.ColumnSpan="2" Style="{StaticResource TrayPopupButtonStyle}"
                        Content="{x:Bind Loc.TrayOpenSwitchboard}" Click="OpenSwitchboard_Click" />
                <Button Grid.Row="1" Style="{StaticResource TrayPopupButtonStyle}"
                        Content="{x:Bind Loc.TrayRefreshAll}" Click="RefreshAll_Click" />
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource TrayPopupButtonStyle}"
                        Content="{x:Bind Loc.TrayOpenCodex}" Click="OpenCodex_Click" />
            </Grid>

            <ScrollViewer Grid.Row="2" MaxHeight="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Loc.TrayChatGptAccounts}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Loc.TrayNoAccounts}" Opacity="0.7"
                               Visibility="{Binding Accounts.ShowEmptyState, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Accounts.AllItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TrayPopupButtonStyle}" Click="Account_Click"
                                        IsEnabled="{Binding CanSwitch}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Usage.StaleBadgeLabel}" FontSize="10"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                       Visibility="{Binding Usage.ShowStaleBadge, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Usage.CompactStatusText}" Opacity="0.7" FontSize="11"
                                                       Visibility="{Binding Usage.ShowCompactStatus, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Usage.CompactObservedAtText}" Opacity="0.62" FontSize="10"
                                                       Visibility="{Binding Usage.CompactObservedAtText, Converter={StaticResource StringToVis}}" />
                                            <TextBlock Text="{Binding Usage.Activity.TraySummaryText}" Opacity="0.68" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{Binding Usage.Activity.TraySummaryTooltip}"
                                                       Visibility="{Binding Usage.Activity.ShowTraySummary, Converter={StaticResource BoolToVis}}" />
                                            <ItemsControl ItemsSource="{Binding Usage.CompactWindows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding CompactSummaryText}" Opacity="0.72" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE73E;" VerticalAlignment="Center"
                                                  Visibility="{Binding IsRoutingActive, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Bind Loc.TrayApiProviders}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Bind Loc.TrayNoApiProviders}" Opacity="0.7"
                               Visibility="{Binding ApiProviders.ShowEmptyState, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding ApiProviders.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TrayPopupButtonStyle}" Click="ApiProvider_Click"
                                        IsEnabled="{Binding CanSwitch}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SelectedModel}" Opacity="0.7" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE73E;" VerticalAlignment="Center"
                                                  Visibility="{Binding IsTargetActive, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Bind Loc.TrayManagedCodexSessions}" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="{x:Bind Loc.TrayNoLaunchProfiles}" Opacity="0.7"
                               Visibility="{Binding LaunchProfiles.HasProfiles, Converter={StaticResource InvBoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding LaunchProfiles.Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TrayPopupButtonStyle}" Click="LaunchProfile_Click">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TargetLabel}" Opacity="0.7" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RuntimeLabel}" Opacity="0.7" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ModelLabel}" Opacity="0.7" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ModelLabel, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ActionLabel}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Spacing="6">
                <Button Style="{StaticResource TrayPopupButtonStyle}"
                        Content="{x:Bind Loc.TrayManageLaunchProfiles}" Click="ManageLaunchProfiles_Click" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Style="{StaticResource TrayPopupButtonStyle}"
                            Content="{x:Bind Loc.TrayOpenSettings}" Click="OpenSettings_Click" />
                    <Button Grid.Column="1" Style="{StaticResource TrayPopupButtonStyle}"
                            Content="{x:Bind Loc.TrayQuit}" Click="Quit_Click" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
