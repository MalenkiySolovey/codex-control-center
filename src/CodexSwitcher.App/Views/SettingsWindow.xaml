<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CodexSwitcher.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:CodexSwitcher.App.Support"
    xmlns:settings="using:CodexSwitcher.App.Features.Settings"
    mc:Ignorable="d"
    Title="Settings &amp; About">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*">
        <!-- Title Bar Header -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Margin="24,0" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind ViewModel.Loc.SettingsTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1" Padding="24,8,24,24">
            <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">

                <!-- About Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="8" Background="{ThemeResource BrandAccentBrush}">
                                <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{ThemeResource BrandOnAccentBrush}" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.AppName}" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.AppVersion}" Opacity="0.7" FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.Loc.AppDescription}" TextWrapping="Wrap" Opacity="0.85" />
                        <TextBlock Text="{x:Bind ViewModel.IndependenceStatement}" TextWrapping="Wrap" Opacity="0.65" FontSize="12" FontStyle="Italic" />

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <HyperlinkButton Content="GitHub Repository" NavigateUri="{x:Bind ViewModel.RepositoryUrl}" />
                            <TextBlock Text="{x:Bind ViewModel.LicenseNotice}" VerticalAlignment="Center" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status Feedback InfoBar -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                         Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         IsClosable="True" />

                <!-- Legacy Migration Card (visible when detected) -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20"
                        Visibility="{x:Bind ViewModel.CanMigrateLegacy, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.Loc.LegacyMigrationSection}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.Loc.LegacyMigrationDetectedMsg}" TextWrapping="Wrap" Opacity="0.85" />
                        <Button Content="{x:Bind ViewModel.Loc.ImportLegacyButton}"
                                Click="OnMigrateLegacyClick"
                                IsEnabled="{x:Bind ViewModel.IsNotMigrating, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Codex Runtime & Diagnostics -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{x:Bind ViewModel.Loc.CodexRuntimeSection}" FontSize="16" FontWeight="SemiBold" />

                        <!-- Diagnostics Grid -->
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="8" ColumnSpacing="16">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind ViewModel.Loc.DetectedRuntimeLabel}" FontWeight="Medium" Opacity="0.8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.DetectedExecutablePath, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind ViewModel.Loc.RuntimeVersionLabel}" FontWeight="Medium" Opacity="0.8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DetectedVersion, Mode=OneWay}" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Bind ViewModel.Loc.RateLimitsCapabilityLabel}" FontWeight="Medium" Opacity="0.8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.RateLimitsCapability, Mode=OneWay}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Bind ViewModel.Loc.AccountActivityCapabilityLabel}" FontWeight="Medium" Opacity="0.8" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.AccountActivityCapability, Mode=OneWay}" />
                        </Grid>

                        <!-- Custom Executable Override -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Loc.CustomRuntimeOverrideLabel}" Opacity="0.85" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <TextBox x:Name="CustomPathBox" Grid.Column="0" Text="{x:Bind ViewModel.CustomExecutablePath, Mode=TwoWay}" PlaceholderText="C:\path\to\codex.exe" />
                                <Button Grid.Column="1" Content="{x:Bind ViewModel.Loc.BrowseButton}" Click="OnBrowseExecutableClick" />
                                <Button Grid.Column="2" Content="{x:Bind ViewModel.Loc.AutoDetectButton}" Click="OnAutoDetectClick" />
                                <Button Grid.Column="3" Content="{x:Bind ViewModel.Loc.ApplyButton}" Click="OnApplyCustomExecutableClick"
                                        Background="{ThemeResource BrandAccentBrush}" Foreground="{ThemeResource BrandOnAccentBrush}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Preferences -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Preferences" FontSize="16" FontWeight="SemiBold" />
                        <ToggleSwitch Header="Always confirm before switching accounts"
                                      IsOn="{x:Bind ViewModel.AlwaysConfirmSwitch, Mode=TwoWay}" />
                        <ComboBox Header="{x:Bind ViewModel.Loc.TrayTooltipModeLabel}"
                                  ItemsSource="{x:Bind ViewModel.TrayTooltipModeOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{x:Bind ViewModel.TrayTooltipPresentationMode, Mode=TwoWay}"
                                  HorizontalAlignment="Left" Width="340" />
                        <TextBlock Text="{x:Bind ViewModel.Loc.TrayTooltipModeDescription}"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                        <ToggleSwitch Header="Start Codex Switchboard with Windows"
                                      IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                        <TextBlock Text="Starts minimized to the system tray. Disable this option to remove only the Switchboard shortcut from your Startup folder."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                        <ToggleSwitch Header="{x:Bind ViewModel.GlobalHotkeyHeader, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.GlobalHotkeyEnabled, Mode=TwoWay}" />
                        <ComboBox Header="Modifier keys"
                                  ItemsSource="{x:Bind ViewModel.GlobalHotkeyModifierChoices}"
                                  SelectedItem="{x:Bind ViewModel.GlobalHotkeyModifiers, Mode=TwoWay}"
                                  HorizontalAlignment="Left" Width="220" />
                        <ComboBox Header="Shortcut key"
                                  ItemsSource="{x:Bind ViewModel.GlobalHotkeyKeyChoices}"
                                  SelectedItem="{x:Bind ViewModel.GlobalHotkeyKey, Mode=TwoWay}"
                                  HorizontalAlignment="Left" Width="180" />
                        <TextBlock Text="Brings Switchboard to the foreground from any app. Choose a modifier combination and letter; if another app already owns that combination, choose another binding or turn the shortcut off."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                        <TextBlock Text="{x:Bind ViewModel.GlobalHotkeyAvailabilityText, Mode=OneWay}"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                    </StackPanel>
                </Border>

                <!-- Floating quick-switch overlay for a foreground Codex Desktop window -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.QuickSwitchOverlayHeader, Mode=OneWay}"
                                   FontSize="16" FontWeight="SemiBold" />
                        <ToggleSwitch Header="{x:Bind ViewModel.Loc.QuickSwitchOverlayEnableLabel}"
                                      IsOn="{x:Bind ViewModel.QuickSwitchOverlayEnabled, Mode=TwoWay}" />
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12">
                            <ComboBox Header="Modifier keys"
                                      ItemsSource="{x:Bind ViewModel.QuickSwitchOverlayModifierChoices}"
                                      SelectedItem="{x:Bind ViewModel.QuickSwitchOverlayModifiers, Mode=TwoWay}"
                                      Width="220" />
                            <ComboBox Grid.Column="1" Header="Shortcut key"
                                      ItemsSource="{x:Bind ViewModel.QuickSwitchOverlayKeyChoices}"
                                      SelectedItem="{x:Bind ViewModel.QuickSwitchOverlayKey, Mode=TwoWay}"
                                      Width="110" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.Loc.QuickSwitchOverlayDescription}"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                        <TextBlock Text="{x:Bind ViewModel.QuickSwitchOverlayAvailabilityText, Mode=OneWay}"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                    </StackPanel>
                </Border>

                <!-- Direct account/provider quick-switch shortcuts -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Direct switch shortcuts" FontSize="16" FontWeight="SemiBold" />
                        <ToggleSwitch Header="Enable assigned account/provider shortcuts"
                                      IsOn="{x:Bind ViewModel.QuickSwitchHotkeysEnabled, Mode=TwoWay}" />
                        <TextBlock Text="Assign a saved account or API provider to a slot, then choose its global shortcut. Each action uses the normal switch confirmation and safety checks."
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.QuickSwitchHotkeyRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="settings:QuickSwitchHotkeyRowViewModel">
                                    <StackPanel Spacing="2" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="{Binding SlotLabel}" VerticalAlignment="Center" MinWidth="72" />
                                            <ComboBox Grid.Column="1" Header="Target"
                                                      ItemsSource="{Binding TargetChoices}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding SelectedTargetKey, Mode=TwoWay}"
                                                      MinWidth="160" />
                                            <ComboBox Grid.Column="2" Header="Modifiers"
                                                      ItemsSource="{Binding ModifierChoices}"
                                                      SelectedItem="{Binding Modifiers, Mode=TwoWay}"
                                                      Width="132" />
                                            <ComboBox Grid.Column="3" Header="Key"
                                                      ItemsSource="{Binding KeyChoices}"
                                                      SelectedItem="{Binding Key, Mode=TwoWay}"
                                                      Width="72" />
                                        </Grid>
                                        <TextBlock Text="{Binding RegistrationStatus}" TextWrapping="Wrap"
                                                   FontSize="12" Opacity="0.75" Margin="80,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind ViewModel.QuickSwitchStatusText, Mode=OneWay}"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
                    </StackPanel>
                </Border>

                <!-- Global notification policy -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Notifications" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Show" Opacity="0.8" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="Information"
                                      IsChecked="{x:Bind ViewModel.ShowInformationalNotifications, Mode=TwoWay}" />
                            <CheckBox Grid.Row="0" Grid.Column="1" Content="Success"
                                      IsChecked="{x:Bind ViewModel.ShowSuccessNotifications, Mode=TwoWay}" />
                            <CheckBox Grid.Row="1" Grid.Column="0" Content="Warnings"
                                      IsChecked="{x:Bind ViewModel.ShowWarningNotifications, Mode=TwoWay}" />
                            <CheckBox Grid.Row="1" Grid.Column="1" Content="Errors"
                                      IsChecked="{x:Bind ViewModel.ShowErrorNotifications, Mode=TwoWay}" />
                        </Grid>
                        <ToggleSwitch Header="Automatically hide notifications"
                                      IsOn="{x:Bind ViewModel.NotificationAutoDismissEnabled, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Hide after" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.NotificationAutoDismissDurations}"
                                      SelectedItem="{x:Bind ViewModel.SelectedNotificationAutoDismissDuration, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      IsEnabled="{x:Bind ViewModel.NotificationAutoDismissEnabled, Mode=OneWay}"
                                      MinWidth="150" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2FA Security Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="18" />
                            <TextBlock Text="{x:Bind ViewModel.Loc.TotpProtectionHeader}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>

                        <ToggleSwitch x:Name="RequireVerificationToggle"
                                      Header="{x:Bind ViewModel.Loc.RequireWindowsVerificationLabel}"
                                      IsOn="{x:Bind ViewModel.RequireWindowsVerificationForTotpReveal, Mode=OneWay}"
                                      Toggled="OnVerificationToggled" />

                        <TextBlock Text="{x:Bind ViewModel.Loc.WindowsVerificationDescription}"
                                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" />

                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.RequireWindowsVerificationForTotpReveal, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.Loc.WindowsVerificationDurationLabel}" FontWeight="Medium" Opacity="0.85" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.DurationOptions}"
                                      SelectedItem="{x:Bind ViewModel.SelectedDuration, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      MinWidth="160" />
                        </StackPanel>

                        <!-- Two-timer explanation notice -->
                        <TextBlock Text="{x:Bind ViewModel.Loc.WindowsVerificationTwoTimerNotice}"
                                   TextWrapping="Wrap" Opacity="0.75" FontSize="12" />

                        <!-- Availability status & methods -->
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="4" ColumnSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind ViewModel.Loc.WindowsHelloMethodLabel}" FontWeight="Medium" Opacity="0.7" FontSize="12" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.WindowsHelloStatus, Mode=OneWay}" Opacity="0.85" FontSize="12" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind ViewModel.Loc.WindowsPasswordMethodLabel}" FontWeight="Medium" Opacity="0.7" FontSize="12" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.WindowsPasswordStatus, Mode=OneWay}" Opacity="0.85" FontSize="12" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Bind ViewModel.Loc.WindowsVerificationStatusLabel}" FontWeight="Medium" Opacity="0.7" FontSize="12" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.WindowsVerificationStatus, Mode=OneWay}" Opacity="0.85" FontSize="12" />
                        </Grid>

                        <!-- Degraded notice when protection preference is ON but both verifiers are unavailable -->
                        <TextBlock Text="{x:Bind ViewModel.Loc.WindowsVerificationDegradedStatusMessage}"
                                   Visibility="{x:Bind ViewModel.IsDegradedProtection, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   TextWrapping="Wrap" FontSize="12" />

                        <!-- Actions: Check again and Open Windows sign-in options -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Bind ViewModel.Loc.CheckAgainButton}"
                                    Click="OnCheckAgainClick"
                                    FontSize="12" />
                            <Button Content="{x:Bind ViewModel.Loc.OpenWindowsSignInOptionsButton}"
                                    Click="OnOpenSignInOptionsClick"
                                    Visibility="{x:Bind ViewModel.CanOpenSignInOptions, Mode=OneWay}"
                                    FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Provider Catalog & Security Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Provider Catalog &amp; Security" FontSize="16" FontWeight="SemiBold" />
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="8" ColumnSpacing="16">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind ViewModel.Loc.CatalogVersionLabel}" FontWeight="Medium" Opacity="0.8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.CatalogVersion, Mode=OneWay}" FontWeight="SemiBold" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind ViewModel.Loc.CatalogSourceLabel}" FontWeight="Medium" Opacity="0.8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CatalogSource, Mode=OneWay}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Bind ViewModel.Loc.KeyBrokerStatusLabel}" FontWeight="Medium" Opacity="0.8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.KeyBrokerStatus, Mode=OneWay}" />
                        </Grid>
                        <Button Content="{x:Bind ViewModel.Loc.ReloadCatalog}" Click="OnReloadCatalogClick" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
