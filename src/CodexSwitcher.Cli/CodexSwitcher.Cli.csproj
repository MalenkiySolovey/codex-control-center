<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>codex-switchboard</AssemblyName>
    <RootNamespace>CodexSwitcher.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexSwitcher.Core\CodexSwitcher.Core.csproj" />
    <ProjectReference Include="..\CodexSwitcher.Infra\CodexSwitcher.Infra.csproj" />
    <EmbeddedResource Include="..\..\schemas\codex-switchboard-cli-export-v1.schema.json">
      <LogicalName>CodexSwitcher.Cli.codex-switchboard-cli-export-v1.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\schemas\codex-switchboard-cli-fleet-v1.schema.json">
      <LogicalName>CodexSwitcher.Cli.codex-switchboard-cli-fleet-v1.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\completions\codex-switchboard.ps1">
      <LogicalName>CodexSwitcher.Cli.codex-switchboard.ps1</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\completions\codex-switchboard.bash">
      <LogicalName>CodexSwitcher.Cli.codex-switchboard.bash</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\completions\codex-switchboard.zsh">
      <LogicalName>CodexSwitcher.Cli.codex-switchboard.zsh</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
